# Gemini (free tier is fine — Flash models only)
GEMINI_API_KEY=
# Comma-separated fallback chain; first that answers wins
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_TEXT_MODELS=gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3.7-flash

# Supabase (optional locally; required on Render because its disk is ephemeral)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media

# Local working dir for downloads, caches and job JSON
DATA_DIR=./data_local
# Frontend origin(s) for CORS, comma-separated
CORS_ORIGINS=http://localhost:3000
# Run ffmpeg shot detection locally (decodes full video; slow on tiny CPUs)
SHOT_DETECT=1

# Anthropic — enables the Claude second-opinion judge (claude-opus-5) on every placement
ANTHROPIC_API_KEY=
