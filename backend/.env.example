# Gemini (free tier is fine — Flash models only)
GEMINI_API_KEY=
# Comma-separated fallback chain; first that answers wins
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_TEXT_MODELS=gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3.7-flash

# Postgres DSN for job persistence (Supabase → Connect → pooler URI). Required on Render (ephemeral disk).
SUPABASE_DB_URL=
